# Generate a private .env with sh deploy/init-env.sh.
# Existing installations must retain these values with their backups.
APP_ORIGIN=http://localhost:3100
OVELIO_PORT=3100
OVELIO_BIND=127.0.0.1
MAILPIT_PORT=8025
OVELIO_ADMIN_EMAIL=admin@ovelio.test
OVELIO_ADMIN_NAME=Administrator
OVELIO_ADMIN_PASSWORD=
CONTACT_HMAC_KEY=
SUPPRESSION_WEBHOOK_SECRET=
OVELIO_DB_PASSWORD=
MAUTIC_USERNAME=ovelio
MAUTIC_ADMIN_EMAIL=journeys@ovelio.test
MAUTIC_PASSWORD=
MAUTIC_DB_PASSWORD=
MAUTIC_DB_ROOT_PASSWORD=
LISTMONK_ADMIN_USER=internal-admin
LISTMONK_ADMIN_PASSWORD=
LISTMONK_DB_PASSWORD=
UMAMI_PASSWORD=
UMAMI_APP_SECRET=
UMAMI_DB_PASSWORD=
UMAMI_2FA_KEY=
SMTP_FROM_EMAIL=hello@ovelio.test
MAIL_FROM_NAME=OVELIO
SMTP_MAUTIC_PASSWORD=
SMTP_LISTMONK_PASSWORD=
SMTP_OVELIO_PASSWORD=
SMTP_RELAY_HOST=mailpit
SMTP_RELAY_PORT=1025
SMTP_RELAY_TLS=local
SMTP_RELAY_USERNAME=
SMTP_RELAY_PASSWORD=
SMTP_DKIM_SELECTOR=
SMTP_VERIFIED_DOMAIN=
# Production uses compose.production.yaml. Set the same origin as HTTPS on this host.
OVELIO_HOST=
# Optional Auth0 OIDC sign-in (Allowed Callback URL: <APP_ORIGIN>/api/auth/auth0/callback, Allowed Logout URL: <APP_ORIGIN>/login)
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_DEFAULT_ROLE=analyst
AUTH0_AUTO_PROVISION=false

# CRM mailboxes (Settings › Mailboxes). MAILBOX_ENCRYPTION_KEY encrypts stored OAuth tokens (AES-256-GCM): 32 random
# bytes as 64 hex characters (openssl rand -hex 32). Keep it with your backups; without it stored tokens cannot be read.
# Gmail: Google Cloud OAuth client, redirect URI <APP_ORIGIN>/api/console/mailboxes/oauth/google/callback.
# Outlook: Microsoft Entra app registration, redirect URI <APP_ORIGIN>/api/console/mailboxes/oauth/microsoft/callback.
MAILBOX_ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# Bounce sources (optional). Leave blank to keep whatever is saved in Listmonk.
# Providers post to <APP_ORIGIN>/webhooks/service/<provider>; for SES, point the SNS topic there.
BOUNCE_PROVIDERS=
BOUNCE_SENDGRID_KEY=
BOUNCE_POSTMARK_USERNAME=
BOUNCE_POSTMARK_PASSWORD=
BOUNCE_AZURE_SHARED_SECRET=
BOUNCE_AZURE_SHARED_SECRET_HEADER=
BOUNCE_FORWARDEMAIL_KEY=
BOUNCE_LETTERMINT_KEY=
BOUNCE_POP_HOST=
BOUNCE_POP_PORT=995
BOUNCE_POP_USERNAME=
BOUNCE_POP_PASSWORD=
BOUNCE_POP_RETURN_PATH=
BOUNCE_POP_SCAN_INTERVAL=15m
BOUNCE_POP_TLS=true
BOUNCE_POP_TLS_SKIP_VERIFY=false
