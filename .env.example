# Generate a private .env with sh deploy/init-env.sh.
# Existing installations must retain these values with their backups.
APP_ORIGIN=http://localhost:3100
OVELIO_PORT=3100
OVELIO_BIND=127.0.0.1
MAILPIT_PORT=8025
OVELIO_ADMIN_EMAIL=admin@ovelio.test
OVELIO_ADMIN_NAME=Administrator
OVELIO_ADMIN_PASSWORD=
CONTACT_HMAC_KEY=
SUPPRESSION_WEBHOOK_SECRET=
OVELIO_DB_PASSWORD=
MAUTIC_USERNAME=ovelio
MAUTIC_ADMIN_EMAIL=journeys@ovelio.test
MAUTIC_PASSWORD=
MAUTIC_DB_PASSWORD=
MAUTIC_DB_ROOT_PASSWORD=
LISTMONK_ADMIN_USER=internal-admin
LISTMONK_ADMIN_PASSWORD=
LISTMONK_DB_PASSWORD=
UMAMI_PASSWORD=
UMAMI_APP_SECRET=
UMAMI_DB_PASSWORD=
UMAMI_2FA_KEY=
SMTP_FROM_EMAIL=hello@ovelio.test
MAIL_FROM_NAME=OVELIO
SMTP_MAUTIC_PASSWORD=
SMTP_LISTMONK_PASSWORD=
SMTP_RELAY_HOST=mailpit
SMTP_RELAY_PORT=1025
SMTP_RELAY_TLS=local
SMTP_RELAY_USERNAME=
SMTP_RELAY_PASSWORD=
SMTP_DKIM_SELECTOR=
SMTP_VERIFIED_DOMAIN=
# Production uses compose.production.yaml. Set the same origin as HTTPS on this host.
OVELIO_HOST=
# Optional Auth0 OIDC sign-in (Allowed Callback URL: <APP_ORIGIN>/api/auth/auth0/callback, Allowed Logout URL: <APP_ORIGIN>/login)
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_DEFAULT_ROLE=analyst
AUTH0_AUTO_PROVISION=false
